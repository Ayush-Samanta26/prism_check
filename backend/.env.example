# --- LLM (required for verification) ---
ANTHROPIC_API_KEY=
# Model used for claim extraction and evidence judgement (must support image input)
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Web search (required: pick one provider and set its key) ---
SEARCH_PROVIDER=tavily        # tavily | brave
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- Database ---
# Local quick start (SQLite):
DATABASE_URL=sqlite:///./prism.db
# Postgres:
# DATABASE_URL=postgresql+psycopg://prism:prism@localhost:5432/prism

# --- OCR ---
# Needs the tesseract binary plus language packs. Falls back to English if a pack is missing.
OCR_LANGS=eng+hin+ben

# --- Server ---
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=8
MAX_IMAGES=4
